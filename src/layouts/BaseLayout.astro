---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Navigation from "../components/Navigation.astro";
import Footer from "../components/Footer.astro";
import logoUrl from "../assets/logo.svg?url";
import { ETSY_LINK } from "../constants";

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
}

const {
  title,
  description = "A one-person fabrication studio in Zwolle, the Netherlands. Handmade dice trays, DM screens, props, and small tools that quietly improve your tabletop sessions.",
  image = "og-default.jpg",
  type = "website",
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const imageURL = new URL(`/images/${image}`, Astro.site);

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "Wildshape Workshop",
  url: Astro.site?.toString(),
  logo: new URL(logoUrl, Astro.site).toString(),
  sameAs: [ETSY_LINK],
};
const orgSchemaJSON = JSON.stringify(orgSchema).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Mathijs" />
    <meta name="publisher" content="Wildshape Workshop" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href={logoUrl} />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Wildshape Workshop" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageURL} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />

    <link
      rel="preload"
      href="/fonts/WorkSans-VariableFont_wght.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/BarlowCondensed-ExtraBold.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <script type="application/ld+json" set:html={orgSchemaJSON} is:inline />

    <slot name="head" />
    <ClientRouter />
  </head>
  <body id="top">
    <a href="#main" class="skip-link">Skip to main content</a>
    <Navigation />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
