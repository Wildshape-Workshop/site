---
import { ETSY_LINK } from "../constants";
import Link from "./Link.astro";
import Logo from "./Logo.astro";
---

<header class="nav">
  <div class="inner">
    <a href="/" class="brand">
      <Logo variant="light" aria-hidden="true" />
      <span class="brand-name">Wildshape Workshop</span>
    </a>

    <nav class="primary" aria-label="Primary">
      <a href="/blog">
        <span class="label-short">Blog</span>
        <span class="label-long">From the workshop</span>
      </a>
      <Link href={ETSY_LINK} target="_blank" class="cta" iconSize={12}>
        Etsy Shop
      </Link>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-primary);
    color: var(--color-primary-foreground);
    --color-ring: var(--color-accent);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-m);
    padding-block: var(--space-s);
    padding-inline:
      max(var(--gutter-x), env(safe-area-inset-left))
      max(var(--gutter-x), env(safe-area-inset-right));
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
  }

  .brand :global(svg) {
    height: 2.5rem;
    width: auto;
  }

  .brand-name {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .primary {
    display: flex;
    align-items: center;
    gap: var(--space-m);
  }

  .primary a {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    color: var(--color-on-primary-subtle);
    white-space: nowrap;
    transition: color var(--transition-base);
  }

  .label-long {
    display: none;
  }

  .primary a:hover {
    color: var(--color-primary-foreground);
  }

  .primary .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    background-color: var(--color-accent);
    color: var(--color-accent-foreground);
    font-weight: var(--weight-medium);
    padding-block: var(--space-2xs);
    padding-inline: var(--space-s);
    transition:
      background-color var(--transition-base),
      transform var(--transition-fast);
  }

  .primary .cta:hover {
    background-color: var(--color-accent-hover);
    color: var(--color-accent-foreground);
  }

  .primary .cta:active {
    transform: translateY(1px);
  }

  @media (pointer: coarse) {
    .primary .cta {
      min-height: 44px;
    }
  }

  @media (min-width: 48rem) {
    .inner {
      padding-inline:
        max(var(--space-2xl), env(safe-area-inset-left))
        max(var(--space-2xl), env(safe-area-inset-right));
    }

    .brand-name {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: normal;
      font-family: var(--font-display);
      font-weight: var(--weight-bold);
      font-size: var(--text-body);
      text-transform: uppercase;
    }

    .primary {
      gap: var(--space-l);
    }

    .label-short {
      display: none;
    }

    .label-long {
      display: inline;
    }
  }
</style>
