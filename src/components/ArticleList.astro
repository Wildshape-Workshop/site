---
import Icon from "./Icon.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  articles: CollectionEntry<"blog">[];
  ctaLabel?: string;
  headingLevel?: 2 | 3;
}

const { articles, ctaLabel = "Read more", headingLevel = 2 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<ul>
  {
    articles.map((article) => (
      <li>
        <a href={`/blog/${article.id}`}>
          <div class="meta">
            <time datetime={article.data.date.toISOString().slice(0, 10)}>
              {dateFormatter.format(article.data.date)}
            </time>
            <span class="tag">{article.data.tag}</span>
          </div>
          <div class="body">
            <Heading
              class="title"
              transition:name={`article-title-${article.id}`}
            >
              {article.data.title}
            </Heading>
            <p>{article.data.excerpt}</p>
            <span class="cta">
              {ctaLabel}
              <Icon name="arrow-right" size={11} />
            </span>
          </div>
        </a>
      </li>
    ))
  }
</ul>

<style>
  ul {
    container-type: inline-size;
    display: flex;
    flex-direction: column;
  }

  li {
    border-block-start: 1px solid var(--color-border);
  }

  li:first-child {
    border-block-start: none;
  }

  a {
    display: grid;
    gap: var(--space-s);
    padding-block: var(--space-l);
  }

  .meta {
    display: flex;
    flex-direction: row;
    gap: var(--space-s);
    padding-block-start: 0.125rem;
  }

  time,
  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
  }

  time {
    color: var(--color-muted-foreground);
  }

  .tag {
    color: var(--color-accent-on-light);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
  }

  .title {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-h4);
    text-transform: uppercase;

    transition: color var(--transition-base);
  }

  a:hover .title {
    color: var(--color-accent-on-light);
  }

  p {
    font-size: var(--text-body-sm);
    color: var(--color-muted-foreground);
    margin-block-end: var(--space-s);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    color: var(--color-muted-foreground);
    transition: color var(--transition-base);
  }

  .cta :global(.icon) {
    transition: transform var(--transition-base);
  }

  a:hover .cta {
    color: var(--color-foreground);
  }

  a:hover .cta :global(.icon) {
    transform: translateX(4px);
  }

  @container (min-width: 36rem) {
    a {
      grid-template-columns: 11.25rem 1fr;
      gap: var(--space-xl);
    }

    .meta {
      flex-direction: column;
      gap: var(--space-3xs);
    }
  }
</style>
