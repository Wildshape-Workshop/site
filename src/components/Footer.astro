---
const year = new Date().getFullYear();
---

<footer>
  <span>
    © {year} Wildshape Workshop - Zwolle, the Netherlands
  </span>
</footer>

<style>
  footer {
    background-color: var(--color-primary);
    color: var(--color-primary-foreground);
    border-block-start: 1px solid
      rgb(from var(--color-primary-foreground) r g b / 0.1);
    padding-block: var(--space-l);
    padding-inline: max(var(--space-2xl), env(safe-area-inset-left)) max(var(--space-2xl), env(safe-area-inset-right));
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  span {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    color: var(--color-primary-foreground);
  }

  @media (min-width: 48rem) {
    footer {
      flex-direction: row;
      align-items: center;
    }
  }
</style>
