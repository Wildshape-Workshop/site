---
const year = new Date().getFullYear();
---

<footer>
  <span class="brand">Wildshape Workshop</span>
  <span class="meta">
    © {year} · Tilburg, Netherlands · hello@wildshapeworkshop.nl
  </span>
</footer>

<style>
  footer {
    background-color: var(--color-primary);
    color: var(--color-primary-foreground);
    border-block-start: 1px solid
      rgb(from var(--color-primary-foreground) r g b / 0.1);
    padding-block: var(--space-l);
    padding-inline: var(--gutter-x);
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2xs);
  }

  .brand {
    font-family: var(--font-display);
    font-weight: var(--weight-bold);
    font-size: var(--text-body-sm);
    text-transform: uppercase;
    letter-spacing: var(--tracking-snug);
    color: rgb(from var(--color-primary-foreground) r g b / 0.7);
  }

  .meta {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    color: rgb(from var(--color-primary-foreground) r g b / 0.35);
  }

  @media (min-width: 48rem) {
    footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }
</style>
