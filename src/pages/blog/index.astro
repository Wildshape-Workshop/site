---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleList from "../../components/ArticleList.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("blog")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout
  title="From the workshop · Wildshape Workshop"
  description="Notes on tools, techniques, and the problems we solve at Wildshape Workshop."
>
  <div class="page">
    <div class="inner">
      <header>
        <p class="eyebrow">Dispatches from Zwolle</p>
        <h1>From the<br />workshop</h1>
        <p class="intro">
          Notes on tools, techniques, and the problems which get solved. Updated when there is something worth saying, not on a schedule.
        </p>
      </header>

      {
        articles.length > 0 ? (
          <ArticleList articles={articles} ctaLabel="Read article" />
        ) : (
          <div class="empty">
            <p class="eyebrow">Nothing here yet</p>
            <p class="empty-body">
              No articles have been written yet. Check back soon.
            </p>
          </div>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    background-color: var(--color-background);
    padding-block-start: var(--space-l);
    padding-block-end: var(--space-3xl);
  }

  .inner {
    max-width: var(--max-width-content);
    margin-inline: auto;
    padding-inline: var(--gutter-x);
  }

  header {
    border-block-end: 1px solid var(--color-border);
    padding-block-end: var(--space-2xl);
    margin-block-end: var(--space-2xl);
  }

  .eyebrow {
    margin-block-end: var(--space-s);
  }

  h1 {
    font-size: var(--text-h2);
    line-height: 0.95;
  }

  .intro {
    margin-block-start: var(--space-m);
    max-width: var(--max-width-prose);
    font-size: var(--text-body);
    color: var(--color-muted-foreground);
  }

  .empty {
    max-width: var(--max-width-prose);
    padding-block: var(--space-2xl);
  }

  .empty .eyebrow {
    margin-block-end: var(--space-s);
  }

  .empty-body {
    font-size: var(--text-body);
    color: var(--color-muted-foreground);
  }
</style>
