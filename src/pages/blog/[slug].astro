---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("blog");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

type Props = { entry: CollectionEntry<"blog"> };
const { entry } = Astro.props;
const { Content } = await render(entry);

const dateFormatted = entry.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

const revealAfterMorph = {
  forwards: {
    old: {
      name: "wsw-fade-out",
      duration: "0.12s",
      fillMode: "both",
    },
    new: {
      name: "wsw-fade-up-in",
      duration: "0.36s",
      delay: "0.24s",
      easing: "cubic-bezier(0.2, 0.8, 0.2, 1)",
      fillMode: "both",
    },
  },
  backwards: {
    old: {
      name: "wsw-fade-out",
      duration: "0.12s",
      fillMode: "both",
    },
    new: {
      name: "wsw-fade-up-in",
      duration: "0.24s",
      easing: "cubic-bezier(0.2, 0.8, 0.2, 1)",
      fillMode: "both",
    },
  },
};
---

<BaseLayout
  title={`${entry.data.title} · Wildshape Workshop`}
  description={entry.data.excerpt}
>
  <article>
    <div class="inner">
      <a href="/blog" class="back" transition:animate={revealAfterMorph}>
        <Icon name="arrow-left" size={12} class="back-icon" />
        All articles
      </a>

      <div class="meta" transition:animate={revealAfterMorph}>
        <time datetime={entry.data.date.toISOString().slice(0, 10)}>
          {dateFormatted}
        </time>
        <span class="tag">{entry.data.tag}</span>
      </div>

      <h1 transition:name={`article-title-${entry.id}`}>
        {entry.data.title}
      </h1>

      <div class="content" transition:animate={revealAfterMorph}>
        <Content />
      </div>

      <footer transition:animate={revealAfterMorph}>
        <a href="/blog" class="more">
          Read more articles
          <Icon name="arrow-right" size={12} />
        </a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  article {
    background-color: var(--color-background);
    padding-block-start: var(--space-l);
    padding-block-end: var(--space-3xl);
  }

  .inner {
    max-width: var(--max-width-narrow);
    margin-inline: auto;
    padding-inline: var(--gutter-x);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    color: var(--color-muted-foreground);
    margin-block-end: var(--space-xl);
    transition: color var(--transition-base);
  }

  .back:hover {
    color: var(--color-accent);
  }

  .back-icon {
    transition: transform var(--transition-base);
  }

  .back:hover .back-icon {
    transform: translateX(-0.25rem);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    margin-block-end: var(--space-l);
  }

  time,
  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
  }

  time {
    color: var(--color-muted-foreground);
  }

  .tag {
    color: var(--color-accent);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  h1 {
    font-size: var(--text-h3);
    line-height: var(--leading-tight);
    margin-block-end: var(--space-2xl);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    max-width: var(--max-width-prose);
  }

  .content :global(p) {
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: rgb(from var(--color-foreground) r g b / 0.8);
  }

  .content :global(h2),
  .content :global(h3),
  .content :global(h4) {
    text-transform: none;
    letter-spacing: normal;
    line-height: var(--leading-tight);
    margin-block-start: var(--space-l);
  }

  .content :global(h2) {
    font-size: var(--text-h4);
  }

  .content :global(h3) {
    font-size: var(--text-h5);
  }

  .content :global(h4) {
    font-size: var(--text-h6);
  }

  .content :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    transition: color var(--transition-base);
  }

  .content :global(a:hover) {
    color: var(--color-foreground);
  }

  .content :global(strong) {
    font-weight: var(--weight-medium);
  }

  .content :global(em) {
    font-style: italic;
  }

  .content :global(ul),
  .content :global(ol) {
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: rgb(from var(--color-foreground) r g b / 0.8);
    padding-inline-start: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }

  .content :global(ul) {
    list-style: disc;
  }

  .content :global(ol) {
    list-style: decimal;
  }

  .content :global(li::marker) {
    color: var(--color-muted-foreground);
  }

  .content :global(blockquote) {
    border-inline-start: 2px solid var(--color-accent);
    padding-inline-start: var(--space-m);
    font-family: var(--font-display);
    font-size: var(--text-h6);
    line-height: var(--leading-snug);
    color: rgb(from var(--color-foreground) r g b / 0.85);
    text-transform: none;
    letter-spacing: var(--tracking-snug);
  }

  .content :global(code) {
    font-family: var(--font-mono);
    font-size: 0.9em;
    background-color: var(--color-card);
    padding-inline: 0.3em;
    padding-block: 0.1em;
    border-radius: var(--radius);
  }

  .content :global(pre) {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    background-color: var(--color-card);
    padding: var(--space-s);
    overflow-x: auto;
  }

  .content :global(pre code) {
    background: none;
    padding: 0;
    font-size: inherit;
  }

  .content :global(hr) {
    border: 0;
    border-block-start: 1px solid var(--color-border);
    margin-block: var(--space-m);
  }

  .content :global(img) {
    max-width: 100%;
    height: auto;
    display: block;
  }

  footer {
    margin-block-start: var(--space-3xl);
    padding-block-start: var(--space-l);
    border-block-start: 1px solid var(--color-border);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    color: var(--color-muted-foreground);
    transition:
      color var(--transition-base),
      gap var(--transition-base);
  }

  .more:hover {
    color: var(--color-accent);
    gap: var(--space-xs);
  }
</style>
