---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { articles, getArticle } from "../../data/articles.ts";

export function getStaticPaths() {
  return articles.map((article) => ({
    params: { slug: article.slug },
  }));
}

const { slug } = Astro.params;
const article = getArticle(slug!);

if (!article) {
  return Astro.redirect("/blog");
}
---

<BaseLayout
  title={`${article.title} · Wildshape Workshop`}
  description={article.excerpt}
>
  <article>
    <div class="inner">
      <a href="/blog" class="back">
        <Icon name="arrow-left" size={12} class="back-icon" />
        All articles
      </a>

      <div class="meta">
        <time>{article.date}</time>
        <span class="tag">{article.tag}</span>
      </div>

      <h1>{article.title}</h1>

      <div class="content">
        {article.content.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <footer>
        <a href="/blog" class="more">
          Read more articles
          <Icon name="arrow-right" size={12} />
        </a>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  article {
    background-color: var(--color-background);
    padding-block-start: var(--space-4xl);
    padding-block-end: var(--space-3xl);
  }

  .inner {
    max-width: var(--max-width-narrow);
    margin-inline: auto;
    padding-inline: var(--gutter-x);
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    color: var(--color-muted-foreground);
    margin-block-end: var(--space-xl);
    transition: color var(--transition-base);
  }

  .back:hover {
    color: var(--color-accent);
  }

  .back-icon {
    transition: transform var(--transition-base);
  }

  .back:hover .back-icon {
    transform: translateX(-0.25rem);
  }

  .meta {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    margin-block-end: var(--space-l);
  }

  time,
  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
  }

  time {
    color: var(--color-muted-foreground);
  }

  .tag {
    color: var(--color-accent);
    font-weight: var(--weight-medium);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
  }

  h1 {
    font-size: var(--text-h3);
    line-height: var(--leading-tight);
    margin-block-end: var(--space-2xl);
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    max-width: var(--max-width-prose);
  }

  .content :global(p) {
    font-size: var(--text-body);
    line-height: var(--leading-relaxed);
    color: rgb(from var(--color-foreground) r g b / 0.8);
  }

  footer {
    margin-block-start: var(--space-3xl);
    padding-block-start: var(--space-l);
    border-block-start: 1px solid var(--color-border);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    font-family: var(--font-mono);
    font-size: var(--text-body-sm);
    color: var(--color-muted-foreground);
    transition:
      color var(--transition-base),
      gap var(--transition-base);
  }

  .more:hover {
    color: var(--color-accent);
    gap: var(--space-xs);
  }
</style>
